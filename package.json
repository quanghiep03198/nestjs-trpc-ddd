{
	"name": "server",
	"version": "0.0.1",
	"description": "",
	"author": "",
	"private": true,
	"license": "UNLICENSED",
	"scripts": {
		"build": "nest build",
		"build:swc": "nest build -b swc",
		"format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
		"start": "nest start",
		"start:dev": "nest start -b swc --watch",
		"start:webpack": "nest build --webpack --webpackPath webpack.config.js --watch",
		"start:debug": "nest start --debug --watch",
		"start:prod": "node dist/main",
		"lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:cov": "jest --coverage",
		"test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
		"test:e2e": "jest --config ./test/jest-e2e.json",
		"typeorm": "SET MIGRATION_DB_HOST=%npm_config_host% && ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli",
		"typeorm:sync": "npm run typeorm ",
		"migration:show": "npm run typeorm migration:show -- -d ./src/databases/data-source.ts",
		"migration:create": "npm run typeorm migration:create ./src/databases/migrations/%npm_config_name%",
		"migration:run": "npm run typeorm migration:run -- -d src/databases/data-source.ts",
		"migration:revert": "npm run typeorm migration:revert -- -d ./src/databases/data-source.ts",
		"seed:run": "SET SEEDING_DB_HOST=%npm_config_host% && ts-node -r tsconfig-paths/register src/databases/seed.ts",
		"seed:create": "npx ts-node -r tsconfig-paths/register ./node_modules/typeorm-extension/bin/cli.cjs seed:create --name src/databases/seeds/%npm_config_name%.seeder.ts",
		"seed:refresh": "npm run migration:revert && npm run migration:run && npm run seed:run"
	},
	"dependencies": {
		"@blazity/nest-file-fastify": "^1.0.0",
		"@fastify/compress": "^8.1.0",
		"@fastify/helmet": "^13.0.2",
		"@fastify/multipart": "^9.3.0",
		"@keyv/redis": "^5.1.3",
		"@nestjs-modules/mailer": "^2.0.2",
		"@nestjs/cache-manager": "^3.0.1",
		"@nestjs/common": "^11.1.8",
		"@nestjs/config": "^4.0.2",
		"@nestjs/core": "^11.1.8",
		"@nestjs/cqrs": "^11.0.3",
		"@nestjs/jwt": "^11.0.1",
		"@nestjs/passport": "^11.0.5",
		"@nestjs/platform-express": "^10.4.20",
		"@nestjs/platform-fastify": "^11.1.8",
		"@nestjs/typeorm": "^11.0.0",
		"@react-email/components": "^0.5.7",
		"bcrypt": "^6.0.0",
		"cache-manager": "^7.2.4",
		"cookie-parser": "^1.4.7",
		"csrf-csrf": "^4.0.3",
		"date-fns": "^4.1.0",
		"dotenv": "^17.2.3",
		"exceljs": "^4.4.0",
		"fastify-sse": "^1.0.0",
		"helmet": "^8.1.0",
		"ioredis": "^5.8.1",
		"lodash": "^4.17.21",
		"ms": "^2.1.3",
		"mssql": "^12.0.0",
		"nestjs-i18n": "^10.5.1",
		"nestjs-pino": "^4.4.1",
		"nodemailer": "^7.0.10",
		"passport": "^0.7.0",
		"passport-google-oauth20": "^2.0.0",
		"passport-local": "^1.0.0",
		"pino-loki": "^2.6.0",
		"pino-pretty": "^13.1.2",
		"reflect-metadata": "^0.2.0",
		"rxjs": "^7.8.1",
		"typeorm": "^0.3.27",
		"typeorm-naming-strategies": "^4.1.0",
		"zod": "^4.1.12"
	},
	"devDependencies": {
		"@compodoc/compodoc": "^1.1.31",
		"@faker-js/faker": "^9.9.0",
		"@nestjs/cli": "^11.0.10",
		"@nestjs/schematics": "^10.2.3",
		"@nestjs/testing": "^10.4.20",
		"@swc/cli": "^0.7.8",
		"@swc/core": "^1.13.5",
		"@types/bcrypt": "^6.0.0",
		"@types/express": "^4.17.17",
		"@types/jest": "^29.5.2",
		"@types/node": "^20.3.1",
		"@types/passport-local": "^1.0.38",
		"@types/supertest": "^6.0.0",
		"@typescript-eslint/eslint-plugin": "^8.0.0",
		"@typescript-eslint/parser": "^8.0.0",
		"copy-webpack-plugin": "^13.0.1",
		"eslint": "^8.42.0",
		"eslint-config-prettier": "^9.0.0",
		"eslint-plugin-prettier": "^5.0.0",
		"jest": "^29.5.0",
		"prettier": "^3.0.0",
		"prettier-plugin-organize-imports": "^4.3.0",
		"run-script-webpack-plugin": "^0.2.3",
		"source-map-support": "^0.5.21",
		"supertest": "^7.0.0",
		"swc-loader": "^0.2.6",
		"ts-jest": "^29.1.0",
		"ts-loader": "^9.4.3",
		"ts-node": "^10.9.1",
		"tsconfig-paths": "^4.2.0",
		"tsconfig-paths-webpack-plugin": "^4.2.0",
		"typeorm-extension": "^3.7.1",
		"typescript": "^5.1.3",
		"webpack": "^5.102.1",
		"webpack-node-externals": "^3.0.0"
	},
	"jest": {
		"moduleFileExtensions": [
			"js",
			"json",
			"ts"
		],
		"rootDir": "src",
		"testRegex": ".*\\.spec\\.ts$",
		"transform": {
			"^.+\\.(t|j)s$": "ts-jest"
		},
		"collectCoverageFrom": [
			"**/*.(t|j)s"
		],
		"coverageDirectory": "../coverage",
		"testEnvironment": "node"
	}
}
